    REAL(SP),allocatable,INTENT(OUT) :: Freq(:)
    REAL(SP),allocatable,INTENT(OUT) :: D_gen(:,:),phi1(:,:),rlamda(:,:)
    REAL(SP),allocatable,INTENT(OUT) :: beta_gen(:),omgn(:)
