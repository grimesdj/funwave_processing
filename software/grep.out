./bc.F:    CALL PHI_COLL(Mloc,Nloc,Ibeg,Iend,Jbeg,Jend,Nghost,U_davg,VTYPE,PERIODIC)
./bc.F:    CALL PHI_COLL(Mloc,Nloc,Ibeg,Iend,Jbeg,Jend,Nghost,U_davg,VTYPE)
./etauv_solver.F:       U_davg(I,J) = P_center(I,J)/Max(H(I,J),MinDepthFrc)
./mixing.F:!                 Cd,Depth,U_davg,V_davg,U_davg_sum,V_davg_sum, &
./mixing.F:!                  U_davg_mean,V_davg_mean,P_center,Q_center,P_sum,Q_sum, &
./mixing.F:!                 Cd,Depth,U_davg,V_davg,U_davg_sum,V_davg_sum, &
./mixing.F:!                  U_davg_mean,V_davg_mean,P_center,Q_center,P_sum,Q_sum, &
./mixing.F:!      REAL(SP),DIMENSION(M,N),INTENT(OUT) :: U_davg_sum,V_davg_sum, &
./mixing.F:!                                             U_davg_mean,V_davg_mean,&
./mixing.F:!      REAL(SP),DIMENSION(M,N),INTENT(IN) :: U_davg,V_davg,P_center,Q_center
./mixing.F:        U_davg_sum=U_davg*DT+U_davg_sum
./mixing.F:        UUsum = (U_davg-U_davg_mean)*(U_davg-U_davg_mean)*(Eta-ETAmean+Depth)*DT + UUsum
./mixing.F:        UVsum = (U_davg-U_davg_mean)*(V_davg-V_davg_mean)*(Eta-ETAmean+Depth)*DT + UVsum
./mixing.F:        U_davg_mean = U_davg_sum/T_sum
./mixing.F:        U_davg_sum = ZERO
./mixing.F:        U_davg_sum=U_davg*DT+U_davg_sum
./mixing.F:        UUsum = (U_davg-U_davg_mean)*(U_davg-U_davg_mean)*(Eta-ETAmean+Depth)*DT + UUsum
./mixing.F:        UVsum = (U_davg-U_davg_mean)*(V_davg-V_davg_mean)*(Eta-ETAmean+Depth)*DT + UVsum
./mixing.F:	Usum_wavg=U_davg*DT+Usum_wavg
./mixing.F:        Usum_wavg=U_davg*DT+Usum_wavg
./init.F:              U_davg(Mloc,Nloc),V_davg(Mloc,Nloc), &
./init.F:              U_davg_sum(Mloc,Nloc),V_davg_sum(Mloc,Nloc), &
./init.F:              U_davg_mean(Mloc,Nloc),V_davg_mean(Mloc,Nloc), &
./init.F:     U_davg = ZERO
./init.F:     U_davg_mean = ZERO
./init.F:     U_davg_sum = ZERO
./mod_global.F:                  P_center,Q_center,U_davg,V_davg,U_davg_sum,V_davg_sum, &
./mod_global.F:                  U_davg_mean,V_davg_mean,P_sum,Q_sum, &
